# `.input` files use TOML syntax.
#
# This reproduces the old `` test as a normal case input.
# The built-in `aw_packet` initializer creates the same large-amplitude
# packet used there: a smooth `phi = psi` superposition of the first three
# modes in each direction, normalized to unit RMS.
#
# Use:
#   python -m rmhdgpu.run examples/aw_packet.input
#   python vis/plot_scalars.py examples/outputs/scalar_diagnostics.csv
#   python vis/plot_fullfield.py examples/outputs/fullfields --field psi --slice-dir z
#

title = "Inhomogeneous rmhd simulation test"
output_dir = "outputs"

[equations]
type = "inhomogeneous_rmhd"
mode = "linear"

[grid]
Nx = 32
Ny = 32
Nz = 32

[time]
# The old sanity script advanced to 0.5 Alfven times. With the default
# periodic box and vA = 1, that is t = pi.
tmax = 20.0
dt_init = 0.1
use_variable_dt = false

[output]
t_out_scal = 0.3141592653589793
t_out_spec = 0.0
t_out_full = 0.0

[backend]
backend = "numpy"

[physics]
vA = 1.0
K_rho0 = -13.8
cs2_over_vA2 = 0.57
K_p0 = 20
g = 2.4

[initial_condition]
type = "single_fourier_mode"
[initial_condition.parameters]
k_indices = [3, 2, 0]
amplitude = 0.000000000001

[runtime]
progress_output_every = 100

# This run is ideal, so the default zero dissipation is retained.
# Set `t_out_full > 0` to write `fullfields/fullfield_0001.h5`, etc.,
# when `h5py` is installed.


[dissipation.psi]
nu_perp = 0.0
nu_par = 0.0
n_perp = 2
n_par = 1

[dissipation.omega]
nu_perp = 0.0
nu_par = 0.0
n_perp = 2
n_par = 1

[dissipation.du_par]
nu_perp = 0.0
nu_par = 0.0
n_perp = 2
n_par = 1

[dissipation.db_par]
nu_perp = 0.0
nu_par = 0.0
n_perp = 2
n_par = 1

[dissipation.drho]
nu_perp = 0.0
nu_par = 0.0
n_perp = 2
n_par = 1