# Variant A: tmax extended to 40, hyperdissipation order n_perp = 3 (unchanged).
# Goal: let the 64^3 run reach the dissipation-limited saturated plateau
# (the t=15 run was still converging, growth rate d(ln E)/dt ~0.36 and falling).

title = "Inhomogeneous rmhd simulation test"
output_dir = "outputs_nokia_tmax40_nperp3"

[equations]
type = "inhomogeneous_rmhd_s"

[grid]
Nx = 64
Ny = 64
Nz = 64

[time]
tmax = 40.0
dt_max = 1.0e-2
cfl_number = 0.2

[output]
t_out_scal = 0.25
t_out_spec = 0.0
t_out_full = 0.0

[backend]
backend = "cupy"

[physics]
vA = 1.0
cs2_over_vA2 = 1.0
g = 3.0
K_p0 = -14.1
K_rho0 = 4.5

[initial_condition]
type = "random_spectrum"

[initial_condition.parameters]
n_min = 1.0
n_max = 10.0
alpha = 0.0
init_energy = 50.0
seed = 1

[runtime]
progress_output_every = 100

[dissipation]
mode = "auto"
n_perp = 3
n_par = 1
nu_par = 0.0
kd_fraction = 0.6
shell_half_width = 0.5
update_every = 10
smooth_factor = 0.2
nu_min = 1e-12
nu_max = 5.0
max_update_factor = 2.0
