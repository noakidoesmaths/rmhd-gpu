title = "Homogeneous limit: pure z+ wave should loop"
output_dir = "outputs_homog_test"

[equations]
type = "inhomogeneous_rmhd_s"

[grid]
Nx = 64
Ny = 64
Nz = 64

[time]
tmax = 13.0            # CHANGE 1: just over two box-crossings (2 x 2pi), not 75
dt_init = 2.0e-3
use_variable_dt = true
cfl_number = 0.5

[output]
t_out_scal = 0.25
t_out_spec = 0.25
t_out_full = 0.2

[backend]
backend = "numpy"

[physics]
vA = 1.0
cs2_over_vA2 = 1.0
K_rho0 = 0.0           # CHANGE 2: was -1.5
g = 0.0                #           was -1.2
K_p0 = 0.0             #           was  0.4

[initial_condition]
type = "random_spectrum_one_wave"

[initial_condition.parameters]
n_min_perp = 2.0
n_max_perp = 8.0
n_min_prl = 3.0
n_max_prl = 4.0
alpha = 0.0
init_energy = 1.0
seed = 1
exclude_kpar0 = true

[runtime]
progress_output_every = 500
project_kpar0 = false

[dissipation]
mode = "manual"        # CHANGE 3: manual + no per-field entries = nu = 0 (ideal)