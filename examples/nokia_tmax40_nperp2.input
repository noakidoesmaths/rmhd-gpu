# Variant B: tmax extended to 40, hyperdissipation order lowered to n_perp = 2.
# Lower n_perp makes the dissipation operator less steep, so it removes energy
# from a broader range of k (reaches a bit lower toward the injection scales).
# Compare its plateau against the n_perp = 3 variant to see which saturates
# cleanest. kd_fraction also nudged to 0.4 so the dissipation scale sits a
# little closer to where the large-scale instability injects energy.

title = "Inhomogeneous rmhd simulation test"
output_dir = "outputs_nokia_tmax40_nperp2"

[equations]
type = "inhomogeneous_rmhd_s"

[grid]
Nx = 64
Ny = 64
Nz = 64

[time]
tmax = 40.0
dt_max = 1.0e-2
cfl_number = 0.2

[output]
t_out_scal = 0.25
t_out_spec = 0.0
t_out_full = 0.0

[backend]
backend = "cupy"

[physics]
vA = 1.0
cs2_over_vA2 = 1.0
g = 3.0
K_p0 = -14.1
K_rho0 = 4.5

[initial_condition]
type = "random_spectrum"

[initial_condition.parameters]
n_min = 1.0
n_max = 10.0
alpha = 0.0
init_energy = 50.0
seed = 1

[runtime]
progress_output_every = 100

[dissipation]
mode = "auto"
n_perp = 2
n_par = 1
nu_par = 0.0
kd_fraction = 0.4
shell_half_width = 0.5
update_every = 10
smooth_factor = 0.2
nu_min = 1e-12
nu_max = 5.0
max_update_factor = 2.0
