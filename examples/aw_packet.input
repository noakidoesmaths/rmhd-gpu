# `.input` files use TOML syntax.
#
# One exact linear Alfven eigenmode of the homogeneous s09 set (`alfven_mode`).
# No `branch` is given, so it is the default "z_plus": a pure
# z+ = delta u_perp - delta B_perp/sqrt(4 pi rho) wave (phi = -psi) travelling
# along +B_0. Set `branch = "z_minus"` under [initial_condition.parameters]
# for the wave travelling the other way.
#
# Use:
#   python -m rmhdgpu.run examples/aw_packet.input
#   python vis/plot_scalars.py examples/outputs_alfven/scalar_diagnostics.csv
#   python vis/plot_fullfield.py examples/outputs_alfven/fullfields --field psi --slice-dir z

title = "Qualitative Alfvén-wave packet translation"
output_dir = "outputs_alfven"

[equations]
type = "s09"

[grid]
Nx = 32
Ny = 32
Nz = 32

[time]
# The old sanity script advanced to 0.5 Alfven times. With the default
# periodic box and vA = 1, that is t = pi.
tmax = 12.56
dt_init = 7.0e-2
use_variable_dt = true
cfl_number = 0.5

[output]
t_out_scal = 0.3141592653589793
t_out_spec = 0.0
t_out_full = 0.2

[backend]
backend = "numpy"

[physics]
vA = 1.0
cs2_over_vA2 = 1.0

[initial_condition]
type = "alfven_mode"            # exact single linear eigenmode

[runtime]
progress_output_every = 100

# This run is ideal, so the default zero dissipation is retained.
# Set `t_out_full > 0` to write `fullfields/fullfield_0001.h5`, etc.,
# when `h5py` is installed.
