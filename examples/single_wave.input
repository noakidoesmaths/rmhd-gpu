# `.input` files use TOML syntax.
#
# A band-limited random pure z+ state of the homogeneous s09 set
# (`random_spectrum_one_wave`): phi = -psi, so only
# z+ = delta u_perp - delta B_perp/sqrt(4 pi rho) is present, and the other
# fields start at zero.
#
# Use:
#   python -m rmhdgpu.run examples/single_wave.input
#   python vis/plot_scalars.py examples/outputs_alfven_single/scalar_diagnostics.csv
#   python vis/plot_fullfield.py examples/outputs_alfven_single/fullfields --field psi --slice-dir z

title = "Qualitative Alfvén-wave packet translation"
output_dir = "outputs_alfven_single"

[equations]
type = "s09"

[grid]
Nx = 32
Ny = 32
Nz = 32

[time]
# The old sanity script advanced to 0.5 Alfven times. With the default
# periodic box and vA = 1, that is t = pi.
tmax = 12.56
dt_init = 7.0e-2
use_variable_dt = true
cfl_number = 0.5

[output]
t_out_scal = 0.3141592653589793
t_out_spec = 0.0
t_out_full = 0.2

[backend]
backend = "numpy"

[physics]
vA = 1.0
cs2_over_vA2 = 1.0

[initial_condition]
type = "random_spectrum_one_wave"

[initial_condition.parameters]
n_min_perp = 2.0
n_max_perp = 8.0
n_min_prl = 3.0
n_max_prl = 4.0
alpha = 0.0
init_energy = 1.0
seed = 1
exclude_kpar0 = true

[runtime]
progress_output_every = 100

# This run is ideal, so the default zero dissipation is retained.
# Set `t_out_full > 0` to write `fullfields/fullfield_0001.h5`, etc.,
# when `h5py` is installed.
