# Plus-only target-amplitude forcing on the inhomogeneous RMHD (rho) equations,
# with the background gradients used in the K_rho0 scan runs.
# The controller holds the rms z+ amplitude near target_value; with nonzero
# gradients some of the injected z+ also leaks linearly into z- and the
# compressive fields. Try a few tau_F values to see which holds the amplitude.
title = "Nokia rho controlled forcing: target amplitude"
output_dir = "outputs_test_forcing_Kp0/ener_1.0_target_3.0_tau_8.0_pm_manual_2"

[equations]
type = "inhomogeneous_rmhd_rho"
mode = "nonlinear"

[grid]
Nx = 32
Ny = 32
Nz = 32

[time]
tmax = 800.0
dt_init = 1.0e-3
use_variable_dt = true
cfl_number = 0.2

[output]
t_out_scal = 0.02
t_out_spec = 0.5
t_out_full = 0.0

[backend]
backend = "scipy_cpu"

[runtime]
progress_output_every = 100
project_kpar0 = false

[physics]
vA = 1.0
cs2_over_vA2 = 0.1
K_rho0 = 3.0
g = 0.0
K_p0 = 0.0

[initial_condition]
type = "random_spectrum_one_wave"

[initial_condition.parameters]
n_min_perp = 1.0
n_max_perp = 3.0
n_min_prl = 1.0
n_max_prl = 3.0
alpha = 4.67
alpha_prl = 1.67
init_energy = 1.0
seed = 1
exclude_kpar0 = false

[forcing]
use_forcing = true
type = "controlled_shell"
forcing_seed = 20260904

# k_sigma_min/max are the k_perp edges of the forced shell, kz_index is the
# forced k_z mode, and branches picks z+ ("plus") and/or z- ("minus").
[forcing.controlled_shell]
k_sigma_min = 2
k_sigma_max = 3
kz_index = 1
branches = ["plus", "minus"]
min_forced_modes = 8
phase_model = "none"
phase_angle_max = 0.5
log_gain_target = 0.05
log_gain_warn = 0.1

# target_value: rms z+ amplitude to aim for. tau_F: relaxation time towards it.
# startup_energy_fraction = 1 starts the run at the target amplitude.
# ring_floor_fraction limits how hard it can damp after an overshoot.
[forcing.controlled_shell.plus]
control = "target"
target_scope = "branch_total"
target_basis = "elsasser"
target_quantity = "rms"
target_value = 3.0
tau_F = 8.0
startup_energy_fraction = 0.01
ring_floor_fraction = 0.01

[forcing.controlled_shell.minus]
control = "target"
target_scope = "branch_total"
target_basis = "elsasser"
target_quantity = "rms"
target_value = 0.3
tau_F = 8.0
startup_energy_fraction = 0.001
ring_floor_fraction = 0.001

[dissipation.psi]
nu_perp = 1.0e-9
nu_par = 0.0
n_perp = 3
n_par = 1

[dissipation.omega]
nu_perp = 1.0e-9
nu_par = 0.0
n_perp = 3
n_par = 1

[dissipation.du_par]
nu_perp = 1.0e-9
nu_par = 0.0
n_perp = 3
n_par = 1

[dissipation.db_par]
nu_perp = 1.0e-9
nu_par = 0.0
n_perp = 3
n_par = 1

[dissipation.drho]
nu_perp = 3.0e-3   
nu_par = 0.0
n_perp = 1
n_par = 1
